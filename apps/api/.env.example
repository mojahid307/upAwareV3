# ─── Database (Supabase PostgreSQL with PostGIS) ───
# Project URL: https://juwtcwlouptklxfmosnm.supabase.co
# Find connection strings in Supabase Dashboard: Project Settings -> Database -> Connection string (URI)

# 1. DATABASE_URL: Transaction Pooler URL (Port 6543) or Session Pooler (Port 5432)
# If using PgBouncer/Supavisor pooler on 6543, append ?pgbouncer=true
DATABASE_URL="postgresql://postgres.juwtcwlouptklxfmosnm:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Direct Connection (Port 5432) used by Prisma CLI for migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.juwtcwlouptklxfmosnm.supabase.co:5432/postgres"

# ─── JWT Secrets ───
JWT_SECRET=super_secret_jwt_key_upaware_dhaka_secure_2026_prod_key_32
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_upaware_dhaka_secure_2026_prod_key_32

# ─── AI (Optional: Anthropic Claude for Phase 7 suggestions) ───
CLAUDE_API_KEY=sk-ant-...

# ─── Media Uploads (Optional: Cloudinary) ───
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Firebase Push (Optional: FCM for Emergency alerts) ───
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@project.iam.gserviceaccount.com

# ─── Server Config ───
PORT=4000
CORS_ORIGIN=http://localhost:3000
